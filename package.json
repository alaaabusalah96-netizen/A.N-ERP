{
  "name": "kemit-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "SERVE_DIST=1 tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run src/emulator_baseline.test.ts src/inventory_rules_emulator.test.ts src/cashier_rules_emulator.test.ts\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:merge": "tsx scripts/verifyMergeAll.ts",
    "verify:an-plane": "tsx scripts/verifyAnPlaneAll.ts",
    "verify:adapter-route": "tsx scripts/verifyAnAdapterRouteTest1.ts",
    "verify:mig-idem": "tsx scripts/verifyAnMigIdem1.ts",
    "verify:adapter-fc2": "tsx scripts/verifyAnAdapterFailClosed2.ts",
    "verify:inv-pilot": "tsx scripts/verifyAnInvPilot1.ts",
    "verify:fix-store": "tsx scripts/verifyAnFixStore1.ts",
    "verify:fix-sec": "tsx scripts/verifyAnFixSec1.ts",
    "verify:auth-bridge": "tsx scripts/verifyAnAuthBridge1.ts",
    "verify:auth-cookies": "tsx scripts/verifyAnAuthCookies1.ts",
    "verify:auth-refresh": "tsx scripts/verifyAnAuthRefreshMe1.ts",
    "verify:auth-rolemap": "tsx scripts/verifyAnAuthRoleMap1.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.0",
    "vite": "^6.2.3",
    "argon2": "^0.45.1",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "pg": "^8.23.0",
    "mysql2": "^3.24.4",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
