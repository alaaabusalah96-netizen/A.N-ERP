# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# A.N ERP - Phase 0 Storage Adapters Connection References (Server-side only)
# PostgreSQL / Supabase (Primary Storage Engine)
DATABASE_URL=""

# MySQL Adapter (Smoke Test Target)
MYSQL_URL=""

# MongoDB Adapter (Smoke Test Target)
MONGO_URL=""

# Firebase Admin SDK Credentials (JSON string or path for Smoke Test Target)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Session Security Token Secret
JWT_SECRET=""

# PII Data Encryption Secret (AES-256-GCM)
PII_ENCRYPTION_SECRET=""

# Mandatory authentication secrets (Enforced via requireEnv at server startup)
# PLATFORM-ADMIN-BOOTSTRAP-1 — set real values only in Secrets UI (never commit)
PLATFORM_ADMIN_USERNAME=""
PLATFORM_ADMIN_PASSWORD=""
# One-shot legacy migration: deactivate other platform accounts + sync/create env admin. Set 0 after login.
PLATFORM_ADMIN_MIGRATE_LEGACY="0"
# Optional for legacy scripts/tests only (not required to boot the server):
INITIAL_USER_PASSWORD=""
RESET_USER_PASSWORD=""
E2E_TEST_PASSWORD=""

# Content-Security-Policy profile ('development' for AI Studio preview / 'production' for strict isolation)
CSP_PROFILE=""

# Test-Only Authentication Bypass Configuration (AUTH-001)
# Strictly forbidden & ignored in production and staging environments.
# Disabled by default. Operative only when NODE_ENV="test" AND ENABLE_TEST_AUTH_BYPASS="true"
ENABLE_TEST_AUTH_BYPASS="false"
TEST_AUTH_BYPASS_SECRET=""

# SEED_FORCE_RESET: legacy flag; platform-admin bootstrap never resets passwords from Secrets.
SEED_FORCE_RESET="false"

