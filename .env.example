# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client / Server Configuration
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID="custodyflow"
FIREBASE_AUTH_DOMAIN="custodyflow.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="custodyflow.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_MEASUREMENT_ID=""

# Client-side Vite Firebase configuration (mirrors above for Vite frontend)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID="custodyflow"
VITE_FIREBASE_AUTH_DOMAIN="custodyflow.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="custodyflow.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Firebase Admin Service Account JSON secret
FIREBASE_SERVICE_ACCOUNT=""

# Platform Owner Identity (Server-only secret)
PLATFORM_OWNER_EMAIL="admin@your-domain.com"

# APP_PEPPER: Server-side cryptographic pepper for active password hashing (version 2).
# CRITICAL: A long, randomly generated secret MUST be set per deployment and never committed.
APP_PEPPER="REPLACE_WITH_LONG_RANDOM_SECRET_NEVER_COMMIT"

# Legacy Peppers for backward-compatibility verification and auto-migration
LEGACY_PEPPER_V1=""
LEGACY_PEPPER_V3=""

# STRICT_PROD_SECURITY: Enables strict production security mode (disables non-strict fallback peppers and plaintext dev fallback).
STRICT_PROD_SECURITY="true"

# ALLOW_AUTO_SEED: If set to "true", allows unauthenticated calls to POST /api/seed/auto-seed during initial bootstrap. Default is disabled ("false").
ALLOW_AUTO_SEED="false"

# MERGE-M3: keep 0/false unless you intentionally activate A.N JWT path (not fully wired for login UI yet)
AN_ENABLE_AN_JWT=0
AN_MIGRATE_WRITES=0

# Google AI Studio / Cloud Preview: leave unset or 0. Local hot reload only: ENABLE_HMR=true
# ENABLE_HMR=true

# Google AI Studio Preview: use built assets (no @vite/client)
SERVE_DIST=1




