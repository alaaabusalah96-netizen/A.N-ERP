/**
 * @file verifySecA.ts
 * @description SEC-A: strict CSP by default in production, trust proxy, per-tenant login lockout, no raw internal errors to the client,
 * bounded fuzz iterations. Pure logic + InMemory (no database). Prints the final "Passed: N | Failed: M" line.
 * Run:  npx tsx scripts/verifySecA.ts
 */
import fs from 'fs';
import { resolveCspProfile, resolveTrustProxy, parseFuzzIterations, FUZZ_MAX_ITERATIONS } from '../src/core/security/runtimeSecurity';
import { publicErrorMessage, isClientSafeMessage } from '../src/core/security/publicError';
import { AnomalyDetector, loginLockKey } from '../src/core/auth/AnomalyDetector';
import { InMemoryAdapter } from '../src/core/storage/adapters/InMemoryAdapter';

let pass = 0, fail = 0;
const check = (label: string, cond: boolean, extra = '') => { if (cond) { pass++; console.log(`[PASS] ${label}`); } else { fail++; console.log(`[FAIL] ${label}${extra ? ' | ' + extra : ''}`); } };

async function main() {
  // ---- CSP profile
  check('C1 default (no env) => development (Vite dev needs inline/eval)', resolveCspProfile({}).profile === 'development' && resolveCspProfile({}).source === 'default');
  check('C2 NODE_ENV=production and no CSP_PROFILE => PRODUCTION (the safe default)', resolveCspProfile({ NODE_ENV: 'production' }).profile === 'production' && resolveCspProfile({ NODE_ENV: ' Production ' }).profile === 'production');
  check('C3 explicit CSP_PROFILE=production wins even in dev', resolveCspProfile({ CSP_PROFILE: 'production' }).profile === 'production' && resolveCspProfile({ NODE_ENV: 'development', CSP_PROFILE: 'PRODUCTION' }).profile === 'production');
  const dp = resolveCspProfile({ NODE_ENV: 'production', CSP_PROFILE: 'development' });
  check('C4 explicit development in a production deployment is allowed but WARNS', dp.profile === 'development' && !!dp.warning && !resolveCspProfile({ CSP_PROFILE: 'development' }).warning);
  check('C5 a garbage CSP_PROFILE falls back to the NODE_ENV rule (never silently weaker in production)', resolveCspProfile({ NODE_ENV: 'production', CSP_PROFILE: 'whatever' }).profile === 'production' && resolveCspProfile({ CSP_PROFILE: 'whatever' }).profile === 'development');

  // ---- trust proxy
  check('P1 nothing set => not set (do not trust X-Forwarded-For by default)', resolveTrustProxy({}).value === undefined);
  check('P2 Cloud Run / AI Studio (K_SERVICE) => exactly 1 hop', resolveTrustProxy({ K_SERVICE: 'an-erp' }).value === 1);
  check('P3 TRUST_PROXY numeric hops, "true" is capped to 1 hop (never an unbounded chain), false/0 turn it off', resolveTrustProxy({ TRUST_PROXY: '2' }).value === 2 && resolveTrustProxy({ TRUST_PROXY: 'true' }).value === 1 && resolveTrustProxy({ TRUST_PROXY: 'false' }).value === false && resolveTrustProxy({ TRUST_PROXY: '0', K_SERVICE: 'x' }).value === false);
  check('P4 TRUST_PROXY subnet list is passed through; explicit value beats K_SERVICE; blank falls back', resolveTrustProxy({ TRUST_PROXY: 'loopback, 10.0.0.0/8' }).value === 'loopback, 10.0.0.0/8' && resolveTrustProxy({ TRUST_PROXY: '3', K_SERVICE: 'x' }).value === 3 && resolveTrustProxy({ TRUST_PROXY: '  ', K_SERVICE: 'x' }).value === 1);

  // ---- fuzz bound
  const okv = (v: unknown) => { const r = parseFuzzIterations(v); return r.ok ? r.value : -1; };
  check('F1 fuzz iterations: default 1000, upper bound accepted, numeric string accepted', okv(undefined) === 1000 && okv(FUZZ_MAX_ITERATIONS) === FUZZ_MAX_ITERATIONS && okv('250') === 250);
  check('F2 fuzz iterations: above the cap, zero, negative, fractional, NaN, text are rejected', [FUZZ_MAX_ITERATIONS + 1, 10_000_000, 0, -5, 1.5, 'abc', NaN, Infinity].every(v => okv(v) === -1));

  // ---- lockout key
  const kA = loginLockKey('tenant-A', 'admin'), kB = loginLockKey('tenant-B', 'admin');
  check('L1 same username in two tenants => different keys; same tenant+username => same key (case and spaces ignored)', kA !== kB && kA === loginLockKey('tenant-A', ' ADMIN ') && kA === loginLockKey('tenant-A', 'admin'));
  check('L2 key fits the 64-char column, has a fixed prefix, handles Arabic and long names', [kA, loginLockKey('t'.repeat(200), 'مدير النظام'), loginLockKey('x', 'u'.repeat(500))].every(k => k.length <= 64 && k.startsWith('lk:')) && loginLockKey('t1', 'a') !== loginLockKey('t1', 'b'));
  const st = new InMemoryAdapter(); const det = new AnomalyDetector(st as any);
  for (let i = 0; i < 5; i++) await det.recordFailedAttempt(kA);
  const la = await det.checkLockout(kA), lb = await det.checkLockout(kB);
  check('L3 5 failures for admin@tenant-A lock A only; admin@tenant-B is untouched', la.isLocked === true && lb.isLocked === false && lb.failedAttempts === 0);
  const old = new AnomalyDetector(new InMemoryAdapter() as any);
  for (let i = 0; i < 5; i++) await old.recordFailedAttempt('admin');
  check('L4 (contrast) the OLD bare-username key locks the same username everywhere — what this fix removes', (await old.checkLockout('admin')).isLocked === true);
  const st2 = new InMemoryAdapter(); const d2 = new AnomalyDetector(st2 as any); const k2 = loginLockKey('tenant-A', 'sara');
  for (let i = 0; i < 4; i++) await d2.recordFailedAttempt(k2);
  await (st2 as any).clearFailedLoginAttempts(k2);
  const again = await d2.recordFailedAttempt(k2);
  check('L5 a successful login clears this tenant+user counter (next failure counts as 1, no lock)', again.failedAttempts === 1 && again.isLocked === false);

  // ---- public error messages
  const logs: string[] = []; const log = (l: string) => logs.push(l);
  const hid = publicErrorMessage(new Error('relation "an_secret_table" does not exist'), { expose: false, log });
  check('E1 a database error is NOT returned: generic Arabic text + reference id, raw text only in the server log', !hid.includes('an_secret_table') && hid.startsWith('حدث خطأ داخلي') && /ERR-[0-9A-F]{8}/.test(hid) && logs.length === 1 && logs[0].includes('an_secret_table') && logs[0].includes(hid.match(/ERR-[0-9A-F]{8}/)![0]));
  const hid2 = publicErrorMessage(new TypeError("Cannot read properties of undefined (reading 'x')"), { expose: false, log });
  check('E2 JS runtime errors and connection errors are hidden', !hid2.includes('Cannot read') && !publicErrorMessage(new Error('connect ECONNREFUSED 10.0.0.5:5432'), { expose: false, log }).includes('10.0.0.5'));
  const before = logs.length;
  check('E3 an Arabic business message written by our code passes through unchanged and is not logged', publicErrorMessage(new Error('السند معكوس مسبقاً.'), { expose: false, log }) === 'السند معكوس مسبقاً.' && logs.length === before);
