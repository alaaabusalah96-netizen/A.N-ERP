const f1DdlStart = ddl.indexOf('Phase F1-v3.2'); const f1DdlEnd = ddl.indexOf('Enable and Force Row Level Security (RLS) on all tenant-isolated tables', f1DdlStart); const f1Ddl = f1DdlStart >= 0 && f1DdlEnd > f1DdlStart ? ddl.slice(f1DdlStart, f1DdlEnd) : ''; check('no ACTIVE seed in F1 DDL', !f1Ddl.includes("DEFAULT 'ACTIVE'"));

