import { AccountingRuleEntry, StoragePort, StorageResult } from '../storage/StoragePort';

export interface AccountingRuleResolutionInput {
  tenantId?: string;
  jurisdictionId: string;
  framework?: string;
  eventType: string;
  asOfDate: string;
}

/**
 * F1 rule registry. `resolveForPosting` is deliberately read-only and only returns
 * authoritative ACTIVE rules already stored with provenance; it does not invent rules.
 */
export class AccountingRuleRegistry {
  constructor(private readonly storage: StoragePort) {}

  save(entry: AccountingRuleEntry, idempotencyKey: string): Promise<StorageResult<AccountingRuleEntry>> {
    return this.storage.saveAccountingRule(entry, idempotencyKey);
  }

  inspectRules(filter?: { jurisdictionId?: string; framework?: string; eventType?: string; status?: string; asOfDate?: string }): Promise<StorageResult<AccountingRuleEntry[]>> {
    return this.storage.listAccountingRules(filter);
  }

  get(id: string): Promise<StorageResult<AccountingRuleEntry | null>> {
    return this.storage.getAccountingRule(id);
  }

  async resolveForPosting(input: AccountingRuleResolutionInput): Promise<StorageResult<AccountingRuleEntry | null>> {
    const run = async (): Promise<StorageResult<AccountingRuleEntry | null>> => {
      const result = await this.storage.listAccountingRules({
        jurisdictionId: input.jurisdictionId,
        framework: input.framework,
        eventType: input.eventType,
        status: 'ACTIVE',
        asOfDate: input.asOfDate,
      });
      if (!result.success) return { success: false, error: result.error };
      const candidates = [...(result.data || [])].sort((a, b) => {
        const date = b.effectiveFrom.localeCompare(a.effectiveFrom);
        return date || b.version.localeCompare(a.version) || a.id.localeCompare(b.id);
      });
      return { success: true, data: candidates[0] || null };
    };
    return input.tenantId ? this.storage.withTenantScope(input.tenantId, run) : run();
  }
}
