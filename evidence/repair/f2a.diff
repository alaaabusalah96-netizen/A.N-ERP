+    }
+    const rep = await svc.getInventoryReconciliation(T);
+    check('(د) pendingJournals >= 1', (rep.data?.pendingJournals || 0) >= 1, `n=${rep.data?.pendingJournals}`);
+  }
+
+  // (و) read-only: three calls identical structure
+  {
