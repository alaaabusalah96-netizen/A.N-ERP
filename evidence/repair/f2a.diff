+        };
+      }
+      const row = res.rows[0];
+      return {
+        success: true,
+        data: {
+          id: row.id,
+          code: row.code,
+          nameAr: row.name_ar,
+          nameEn: row.name_en,
+          taxNumber: row.tax_number,
+          backendConfig: row.backend_config,
+          status: row.status,
