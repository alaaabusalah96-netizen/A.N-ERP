+            type: 'https://api.an-erp.local/errors/proof-required',
+            title: 'مرفق إثبات الصرف إلزامي',
+            status: 400,
+            detail: 'كل صرف من العهدة النقدية يُسجَّل بمرفق إثبات (فاتورة/إيصال) وفق متطلبات الامتثال (بند 5B).',
+          },
+        };
