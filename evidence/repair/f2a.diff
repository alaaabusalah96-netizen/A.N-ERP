+              expenseAccountCode: payload.expenseAccountCode || '5040',
+              description: payload.description || 'صرف من العهدة النقدية',
+              amount: payload.amount || 0,
+              costCenterId: payload.costCenterId,
+              receiptNumber: payload.receiptNumber,
