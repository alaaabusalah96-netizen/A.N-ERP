+          success: false,
+          error: {
+            type: 'https://api.an-erp.local/errors/invalid-parameter',
+            title: 'مبلغ المصروف غير صالح',
+            status: 400,
+            detail: 'يجب أن يكون مبلغ كل بند في المصروف أكبر من صفر.',
