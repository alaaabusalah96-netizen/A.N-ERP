+  targetWarehouseId: string;
+  lines: Array<{
+    itemId: string;
+    quantity: number;
+    batchNumber?: string;
+    serialNumber?: string;
+  }>;
+  requestedBy: string;
+  requestedByName: string;
+  notes?: string;
