+    const key = `${tenantId}:${nodeId}`;
+    const node = this.orgNodes.get(key);
+    if (!node) {
+      return {
+        success: false,
+        error: {
+          type: 'https://api.an-erp.local/errors/node-not-found',
+          title: 'العقدة التنظيمية غير موجودة',
+          status: 404,
+          detail: `العقدة ${nodeId} غير مسجلة في هيكل المنشأة`,
