+          try {
+            process.kill(-proc.pid, 'SIGKILL');
+          } catch {
+            try {
+              proc.kill('SIGKILL');
+            } catch {}
+          }
+        }
+        done(0);
+      }, 1500);
+    });
+  };
+
+  return { output: combinedOutput, stop };
+}
