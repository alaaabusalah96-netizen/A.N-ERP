+          success: false,
+          error: {
+            type: 'https://api.an-erp.local/errors/proof-required',
+            title: 'رقم الفاتورة أو الإيصال إلزامي',
+            status: 400,
+            detail: 'لا يمكن تسجيل صرف من العهدة دون رقم فاتورة أو إيصال رسمي مطابق للمستند (بند 5B).',
