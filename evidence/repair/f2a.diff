+  console.log('                 AUTH-001 VERIFICATION SUMMARY                         ');
+  console.log('========================================================================');
+
+  let passedCount = 0;
+  let failedCount = 0;
+
+  for (const r of allResults) {
+    const mark = r.passed ? '✓ PASS' : '✗ FAIL';
