+
+    const nowIso = new Date().toISOString();
+
+    const updateRes = await this.port.updateExpenseRequestStatus(
+      tenantId,
+      request.id,
+      {
+        status: 'APPROVED',
+        currentApprovalTier: 'COMPLETED',
+        approvedBy: payload.approverId,
+        approvedByName: payload.approverName,
+        approvedAt: nowIso,
