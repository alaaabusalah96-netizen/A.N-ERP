+  console.log('------------------------------------------------------------------------');
+  console.log(`TOTAL: ${allResults.length} | PASSED: ${passedCount} | FAILED: ${failedCount}`);
+  console.log('========================================================================\n');
+
+  if (failedCount > 0) {
