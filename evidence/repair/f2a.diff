+  // accounts for phase 14 journals
+  for (const c of [
+    { code: '1105', type: 'ASSET' }, { code: '2106', type: 'LIABILITY' }, { code: '5101', type: 'EXPENSE' }, { code: '1109', type: 'ASSET' },
