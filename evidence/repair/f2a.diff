+  platform_admin: new Set<PermissionGroup>([
+    'SYSTEM_HEALTH_VIEW', 'USER_MANAGE', 'COMPANY_SETTINGS_MANAGE', 'PLATFORM_ADMIN', 'AUDIT_LOG_VIEW',
+    'PURCHASE_VIEW', 'PURCHASE_MANAGE', 'APPROVAL_POLICY_MANAGE',
