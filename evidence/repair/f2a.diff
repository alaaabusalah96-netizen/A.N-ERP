+            >
+              <LogOut className="w-4 h-4" />
+              تسجيل الخروج من هذا الجهاز
+            </button>
+          </div>
+        </div>
+      </div>
+
+      {/* Active Sessions Management (Section 1I) */}
+      <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs">
